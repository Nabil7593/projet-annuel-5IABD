# Database (Neon.tech)
# Pooler URL - utilisée pour les requêtes (connexions serverless)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct URL - utilisée pour les migrations Prisma (sans -pooler dans le hostname)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
